<UserControl x:Class="PcCheck.App.Views.FixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:PcCheck.App"
             xmlns:views="clr-namespace:PcCheck.App.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="PlanRowTemplate">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Target}" Style="{StaticResource Mono}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ReversibleText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{x:Static r:Strings.Fix_Title}" Style="{StaticResource H1}" Margin="0,0,0,16"/>
            <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource BrandBrush}" BorderThickness="1" CornerRadius="6" Padding="14,8" Margin="0,0,0,14"
                    Visibility="{Binding IsPreview, Converter={StaticResource BoolToVisibility}}">
                <TextBlock TextWrapping="Wrap" Text="{x:Static r:Strings.Fix_Preview}"/>
            </Border>
        </StackPanel>

        <!-- Overview -->
        <Grid Grid.Row="1" Visibility="{Binding IsOverview, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource WarnBgBrush}" BorderBrush="#D4A72C" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                <TextBlock TextWrapping="Wrap" Text="{x:Static r:Strings.Fix_Intro}"/>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{x:Static r:Strings.Fix_Auto}" Style="{StaticResource H2}"/>
                            <TextBlock Text="{x:Static r:Strings.Fix_None}" Style="{StaticResource Muted}" Visibility="{Binding AutoRows.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=empty}"/>
                            <ItemsControl ItemsSource="{Binding AutoRows}" ItemTemplate="{StaticResource PlanRowTemplate}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{x:Static r:Strings.Fix_Confirm}" Style="{StaticResource H2}"/>
                            <TextBlock Text="{x:Static r:Strings.Fix_None}" Style="{StaticResource Muted}" Visibility="{Binding ConfirmRows.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=empty}"/>
                            <ItemsControl ItemsSource="{Binding ConfirmRows}" ItemTemplate="{StaticResource PlanRowTemplate}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{x:Static r:Strings.Fix_Advice}" Style="{StaticResource H2}"/>
                            <TextBlock Text="{x:Static r:Strings.Fix_None}" Style="{StaticResource Muted}" Visibility="{Binding Advice.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=empty}"/>
                            <ItemsControl ItemsSource="{Binding Advice}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock FontWeight="SemiBold"><Run Text="{Binding Info.Name, Mode=OneWay}"/> <Run Text="{Binding FindingTitle, Mode=OneWay, StringFormat=({0})}" FontWeight="Normal" Foreground="{StaticResource MutedBrush}"/></TextBlock>
                                            <TextBlock Text="{Binding Info.Advice}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="{x:Static r:Strings.Fix_Back}" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" AutomationProperties.AutomationId="BackButton"/>
                <Button Content="{x:Static r:Strings.Fix_Start}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding StartCommand}"
                        IsEnabled="{Binding HasActions}" AutomationProperties.AutomationId="FixStartButton"/>
            </StackPanel>
        </Grid>

        <!-- Working -->
        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding WorkingText}" FontSize="16" Margin="0,0,0,12"/>
                <ProgressBar Height="8" IsIndeterminate="True"/>
            </StackPanel>
        </Border>

        <!-- Restore point failed -->
        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding IsAskRestore, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{x:Static r:Strings.Fix_RestoreFailed}" Style="{StaticResource H2}" Foreground="{StaticResource CriticalBrush}"/>
                <TextBlock Text="{Binding RestoreError}" Style="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock TextWrapping="Wrap" Text="{x:Static r:Strings.Fix_RestoreFailedBody}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="{x:Static r:Strings.Fix_Stop}" Style="{StaticResource SecondaryButton}" Command="{Binding StopCommand}" AutomationProperties.AutomationId="StopButton"/>
                    <Button Content="{x:Static r:Strings.Fix_ContinueNoRestore}" Style="{StaticResource SecondaryButton}" Command="{Binding ContinueWithoutRestoreCommand}" AutomationProperties.AutomationId="ContinueButton"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Confirm one item -->
        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding IsConfirm, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Grid>
                    <TextBlock Text="{x:Static r:Strings.Fix_Ask}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding ConfirmCounter}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock Text="{Binding CurrentTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding CurrentKind}" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,10"/>
                <Border Background="{StaticResource BgBrush}" CornerRadius="4" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentTarget}" Style="{StaticResource Mono}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CurrentCommand}" Style="{StaticResource Mono}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding CurrentCommand, Converter={StaticResource NullToCollapsed}}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding CurrentReversible}" Margin="0,10,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentIrreversible}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource CriticalBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="{x:Static r:Strings.Fix_SkipAll}" Style="{StaticResource SecondaryButton}" Command="{Binding SkipAllCommand}" AutomationProperties.AutomationId="SkipAllButton"/>
                    <Button Content="{Binding ApproveKindText}" Style="{StaticResource SecondaryButton}" Command="{Binding ApproveKindCommand}"
                            Visibility="{Binding HasSameKind, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="ApproveKindButton"/>
                    <Button Content="{x:Static r:Strings.Fix_Skip}" Style="{StaticResource SecondaryButton}" Command="{Binding SkipCommand}" AutomationProperties.AutomationId="SkipButton"/>
                    <Button Content="{x:Static r:Strings.Fix_Approve}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding ApproveCommand}" AutomationProperties.AutomationId="ApproveButton"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Done -->
        <Grid Grid.Row="1" Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <views:LeakDrop Mode="{Binding DoneMode, Mode=OneWay}" Count="{Binding FailedCount, Mode=OneWay}" Width="34" Margin="0,0,14,0"
                                VerticalAlignment="Center" AutomationProperties.AutomationId="DoneDrop"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DoneSummary}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
                        <Run Text="{x:Static r:Strings.Fix_Log}"/> <Run Text="{Binding ActionsPath, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Results}" Margin="20,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" FontSize="12"
                                                   Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource CriticalBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static r:Strings.Status_Skipped}">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="{x:Static r:Strings.Fix_GoUndo}" Style="{StaticResource SecondaryButton}" Command="{Binding GoUndoCommand}" AutomationProperties.AutomationId="GoUndoButton"/>
                <Button Content="{x:Static r:Strings.Fix_Home}" Style="{StaticResource SecondaryButton}" Command="{Binding HomeCommand}" AutomationProperties.AutomationId="HomeButton"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
