<UserControl x:Class="PcCheck.App.Views.ProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PcCheck.App.Views">
    <Grid Margin="40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="점검 중" Style="{StaticResource H1}"/>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource Muted}" FontSize="14">
                <Run Text="경과"/> <Run Text="{Binding Elapsed, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/>
            </TextBlock>
        </Grid>

        <!-- Steps -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Steps}" Margin="0,18,0,16">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Bd" Margin="0,0,8,0" Padding="14,10" CornerRadius="6"
                            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Mark" Text="○" Width="20" FontSize="14" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Label" Text="{Binding Title}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                            <Setter TargetName="Mark" Property="Text" Value="✓"/>
                            <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource OkBrush}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="Mark" Property="Text" Value="●"/>
                            <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Sampling and overall progress -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <views:LeakDrop Mode="Progress" Value="{Binding OverallFraction}" Width="40" Margin="0,0,20,0" VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ProgressDrop"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="리소스 측정" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SamplingText}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar Height="10" Margin="0,10,0,0" Maximum="1" Value="{Binding SamplingFraction, Mode=OneWay}"
                                 Foreground="{StaticResource AccentBrush}" Background="{StaticResource BgBrush}" BorderThickness="0"/>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="완료한 항목" Style="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding CompletedText}" FontFamily="{StaticResource MonoFont}" FontSize="26" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14"
                Visibility="{Binding HasDefenderNote, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding DefenderNote}" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Border Background="#FFEBE9" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1" CornerRadius="6"
                        Padding="14,10" Margin="16" VerticalAlignment="Top" Panel.ZIndex="1"
                        Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="230"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Id}" Style="{StaticResource Mono}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource CriticalBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ProgressBar Grid.Column="3" Height="6" Margin="0,0,16,0" Maximum="1"
                                                     Value="{Binding Fraction, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Message}" Style="{StaticResource Muted}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="처음으로" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}"
                    Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}"/>
            <Button Content="취소" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="CancelButton"/>
        </StackPanel>
    </Grid>
</UserControl>
