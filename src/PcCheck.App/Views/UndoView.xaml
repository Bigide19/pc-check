<UserControl x:Class="PcCheck.App.Views.UndoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:PcCheck.App">
    <Grid Margin="40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static r:Strings.Undo_Title}" Style="{StaticResource H1}"/>
        <StackPanel Grid.Row="1">
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,6,0,14" TextWrapping="Wrap"/>
            <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource BrandBrush}" BorderThickness="1" CornerRadius="6" Padding="14,8" Margin="0,0,0,14"
                    Visibility="{Binding IsPreview, Converter={StaticResource BoolToVisibility}}">
                <TextBlock TextWrapping="Wrap" Text="{x:Static r:Strings.Fix_Preview}"/>
            </Border>
        </StackPanel>
        <Border Grid.Row="2" Background="#FFEBE9" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14"
                Visibility="{Binding FailureNote, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="{Binding FailureNote}" TextWrapping="Wrap"/>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" Visibility="{Binding HasLog, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rows}" Margin="20,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Target}" Style="{StaticResource Mono}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" FontSize="12"
                                               Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Status}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource CriticalBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static r:Strings.Undo_Undone}">
                                                    <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{x:Static r:Strings.Undo_Home}" Style="{StaticResource SecondaryButton}" Command="{Binding HomeCommand}" AutomationProperties.AutomationId="HomeButton"/>
            <Button Content="{x:Static r:Strings.Undo_Run}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding RunCommand}" AutomationProperties.AutomationId="UndoRunButton"/>
        </StackPanel>
    </Grid>
</UserControl>
