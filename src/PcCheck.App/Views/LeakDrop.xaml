<UserControl x:Class="PcCheck.App.Views.LeakDrop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Viewbox Stretch="Uniform">
        <Canvas x:Name="Root" Width="80" Height="136">
            <Path x:Name="Back" Data="{StaticResource DropGeometry}" Fill="{StaticResource BrandBrush}"/>
            <Canvas x:Name="Tank" Width="80" Height="96" Clip="{StaticResource DropGeometry}" Visibility="Collapsed">
                <Rectangle Width="80" Height="96" Fill="{StaticResource BrandBrush}">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="LevelShift" Y="96"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>
            <Path x:Name="Outline" Data="{StaticResource DropGeometry}" Stroke="{StaticResource BrandSurfaceBrush}" StrokeThickness="3" Visibility="Collapsed"/>
            <Path x:Name="Check" Data="M 24,62 L 35,73 L 56,51" Stroke="{StaticResource BrandSurfaceBrush}" StrokeThickness="9"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            <TextBlock x:Name="CountText" Canvas.Top="42" Width="80" TextAlignment="Center" FontFamily="Segoe UI" FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource BrandSurfaceBrush}" Visibility="Collapsed"/>
            <Path x:Name="Drip1" Data="{StaticResource DripGeometry}" Fill="{StaticResource BrandBrush}" Opacity="0">
                <Path.RenderTransform><TranslateTransform/></Path.RenderTransform>
            </Path>
            <Path x:Name="Drip2" Data="{StaticResource DripGeometry}" Fill="{StaticResource BrandBrush}" Opacity="0">
                <Path.RenderTransform><TranslateTransform/></Path.RenderTransform>
            </Path>
            <Rectangle x:Name="Plug" Canvas.Left="20" Canvas.Top="104" Width="40" Height="7" RadiusX="3.5" RadiusY="3.5"
                       Fill="{StaticResource BrandSurfaceBrush}" Visibility="Collapsed"/>
        </Canvas>
    </Viewbox>
</UserControl>
