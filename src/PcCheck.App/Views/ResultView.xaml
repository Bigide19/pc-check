<UserControl x:Class="PcCheck.App.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:PcCheck.App"
             xmlns:views="clr-namespace:PcCheck.App.Views">
    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Verdict banner -->
        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="8,0,0,8" Background="{Binding Report.Verdict.Primary, Converter={StaticResource VerdictBrush}}"/>
                <StackPanel Grid.Column="1" Margin="20,14,0,14" VerticalAlignment="Center" Width="64">
                    <views:LeakDrop Mode="{Binding LeakMode, Mode=OneWay}" Count="{Binding LeakCount, Mode=OneWay}" Width="44"
                                    AutomationProperties.AutomationId="VerdictDrop"/>
                    <TextBlock Text="{Binding LeakText}" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="20,16">
                    <WrapPanel>
                        <TextBlock Text="{Binding VerdictText}" FontSize="26" FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Foreground="{Binding Report.Verdict.Primary, Converter={StaticResource VerdictBrush}}"/>
                        <Border Style="{StaticResource Badge}" Background="{StaticResource BgBrush}" Margin="14,0,0,0"
                                Visibility="{Binding SecondaryText, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Text="{Binding SecondaryText}" FontSize="13"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding VerdictDescription}" Margin="0,6,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding BasisText}" Style="{StaticResource Mono}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="20,16" HorizontalAlignment="Right" MaxWidth="280">
                    <TextBlock Text="{Binding Report.Machine.Name}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding Report.Machine.Os}" Style="{StaticResource Muted}" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right"/>
                    <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Right">
                        <Run Text="{Binding Report.Machine.RamGb, Mode=OneWay, StringFormat={}{0} GB}"/><Run Text=" · "/><Run Text="{Binding Report.Machine.SystemDisk, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding ScannedAtText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Three leaks: each card filters the findings list -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding LeakCards}" Margin="0,0,-10,10" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.SelectLeakCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" IsEnabled="{Binding Checked}" Margin="0,0,10,0" Cursor="Hand"
                            AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Title}">
                        <Button.ToolTip>
                            <StackPanel MaxWidth="320">
                                <TextBlock Text="{Binding Tip}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Static r:Strings.Leak_FilterTip}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button.ToolTip>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FieldHoverBrush}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <views:LeakDrop Mode="{Binding Mode, Mode=OneWay}" Count="{Binding Count, Mode=OneWay}" Drips="False"
                                            Width="24" Height="34" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Scores (performance) -->
        <Grid Grid.Row="2" Margin="0,0,0,14" Visibility="{Binding ShowScores, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="145"/>
                <ColumnDefinition Width="Auto" MinWidth="145"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{x:Static r:Strings.Result_HardwareSubtotal}" Style="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding Report.Scores.Hardware}" FontFamily="{StaticResource MonoFont}" FontSize="30" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{x:Static r:Strings.Result_SoftwareSubtotal}" Style="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding Report.Scores.Software}" FontFamily="{StaticResource MonoFont}" FontSize="30" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12">
                <ItemsControl ItemsSource="{Binding CategoryScores}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="3,0">
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" Style="{StaticResource Muted}" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Score}" FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>

        <!-- Details -->
        <TabControl Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="0">
            <TabItem Header="{Binding FindingsHeader}">
                <Grid>
                    <TextBlock Text="{x:Static r:Strings.Result_NoFindings}" Style="{StaticResource Muted}" Margin="20"
                               Visibility="{Binding VisibleFindings.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=empty}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding VisibleFindings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource Badge}" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                    Background="{Binding Finding.Severity, Converter={StaticResource SeverityBrush}}">
                                                <TextBlock Text="{Binding SeverityText}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Finding.Title}" FontWeight="SemiBold" FontSize="15"/>
                                                    <TextBlock Text="{Binding Finding.Id}" Style="{StaticResource Mono}" Foreground="{StaticResource MutedBrush}"
                                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding CategoryText}" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Finding.Detail}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                <Border Background="{StaticResource BgBrush}" CornerRadius="4" Padding="10,6" Margin="0,8,0,0"
                                                        Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding EvidenceText}" Style="{StaticResource Mono}" TextWrapping="Wrap"/>
                                                </Border>
                                                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"
                                                           Visibility="{Binding RemediationText, Converter={StaticResource NullToCollapsed}}">
                                                    <Run Text="{x:Static r:Strings.Result_Action}"/><Run Text="{Binding RemediationText, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static r:Strings.Result_TopProcesses}">
                <Grid>
                    <TextBlock Text="{x:Static r:Strings.Result_NoSampling}" Style="{StaticResource Muted}" Margin="20"
                               Visibility="{Binding ProcessColumns.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=empty}"/>
                    <ItemsControl ItemsSource="{Binding ProcessColumns}" Margin="10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="10">
                                    <TextBlock Style="{StaticResource H2}">
                                        <Run Text="{Binding Title, Mode=OneWay}"/> <Run Text="{Binding Unit, Mode=OneWay, StringFormat=({0})}" Foreground="{StaticResource MutedBrush}" FontWeight="Normal"/>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="30">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Name, Mode=OneWay}"/> <Run Text="{Binding Pid, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1" Text="{Binding ValueText}" Style="{StaticResource Mono}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static r:Strings.Result_Candidates}">
                <Grid>
                    <TextBlock Text="{x:Static r:Strings.Result_NoCandidates}" Style="{StaticResource Muted}" Margin="20"
                               Visibility="{Binding RemediationGroups.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=empty}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RemediationGroups}" Margin="20,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}"/>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="190"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="120"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Id}" Style="{StaticResource Mono}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Name, Mode=OneWay}"/> <Run Text="{Binding FindingId, Mode=OneWay, StringFormat=({0})}" Foreground="{StaticResource MutedBrush}"/>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="2" Text="{Binding ReversibleText}" Style="{StaticResource Muted}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding ErrorsHeader}">
                <Grid>
                    <TextBlock Text="{x:Static r:Strings.Result_NoErrors}" Style="{StaticResource Muted}" Margin="20"
                               Visibility="{Binding Errors.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=empty}"/>
                    <ItemsControl ItemsSource="{Binding Errors}" Margin="20,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Error.CollectorId}" Style="{StaticResource Mono}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource CriticalBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Error.Message}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="220"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center" Margin="0,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBox Text="{Binding SlackUrl, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                             Padding="8,7" VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderBrush}"
                             AutomationProperties.AutomationId="SlackUrlBox" AutomationProperties.Name="{x:Static r:Strings.Result_SlackUrl}"/>
                    <TextBlock Text="{x:Static r:Strings.Result_SlackHint}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding SlackUrl, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}"/>
                </Grid>
                <Button Grid.Column="1" Content="{x:Static r:Strings.Result_SendSlack}" Style="{StaticResource SecondaryButton}" Command="{Binding SendSlackCommand}"
                        AutomationProperties.AutomationId="SlackSendButton"/>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SlackStatus}" FontSize="12" Margin="2,4,0,0" TextWrapping="Wrap"
                           Visibility="{Binding SlackStatus, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SlackFailed}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource CriticalBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Content="{x:Static r:Strings.Result_OpenReport}" Style="{StaticResource SecondaryButton}" Command="{Binding OpenReportCommand}" IsEnabled="{Binding CanOpenReport}" AutomationProperties.AutomationId="OpenReportButton"/>
            <Button Content="{x:Static r:Strings.Result_Bundle}" Style="{StaticResource SecondaryButton}" Command="{Binding OpenBundleCommand}"
                    ToolTip="{x:Static r:Strings.Result_BundleTip}" AutomationProperties.AutomationId="OpenBundleButton"/>
            <Button Content="{x:Static r:Strings.Result_NewScan}" Style="{StaticResource SecondaryButton}" Command="{Binding NewScanCommand}" AutomationProperties.AutomationId="NewScanButton"/>
            <Button Content="{x:Static r:Strings.Result_Fix}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="22,9" FontSize="14" Command="{Binding FixCommand}"
                    IsEnabled="{Binding CanFix}" AutomationProperties.AutomationId="FixButton"/>
        </StackPanel>
        </Grid>
    </Grid>
</UserControl>
