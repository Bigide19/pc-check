<Window x:Class="PcCheck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:PcCheck.App"
        xmlns:vm="clr-namespace:PcCheck.App.ViewModels"
        xmlns:views="clr-namespace:PcCheck.App.Views"
        Title="{Binding Title}" Width="1120" Height="780" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="Assets/pccheck.ico"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:StartViewModel}"><views:StartView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgressViewModel}"><views:ProgressView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResultViewModel}"><views:ResultView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FixViewModel}"><views:FixView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UndoViewModel}"><views:UndoView/></DataTemplate>
    </Window.Resources>
    <DockPanel x:Name="Root">
        <Border DockPanel.Dock="Top" Background="{StaticResource BrandSurfaceBrush}" Height="55"
                BorderBrush="{StaticResource BrandBrush}" BorderThickness="0,0,0,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <Viewbox Width="20" Height="25" Margin="0,0,11,0" AutomationProperties.Name="{x:Static r:Strings.Win_Symbol}">
                        <Canvas Width="80" Height="98">
                            <Path Fill="{StaticResource BrandBrush}" Data="{StaticResource DropGeometry}"/>
                            <Path Data="M 24,62 L 35,73 L 56,51" Stroke="{StaticResource BrandSurfaceBrush}" StrokeThickness="9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="PC Check" FontFamily="Segoe UI" FontSize="21" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <Border Background="#1F4A52" CornerRadius="99" Padding="8,1" Margin="10,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VersionText}" FontFamily="Segoe UI" FontSize="11" Foreground="#BFE6EA"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Static r:Strings.Win_Tagline}" Foreground="#9FB9BD" FontSize="12" VerticalAlignment="Center" Margin="0,0,18,0"/>
                <Button Grid.Column="2" Style="{StaticResource LanguageButton}" Click="OnSwitchLanguage" Margin="0,0,12,0"
                        Visibility="{Binding CanSwitchLanguage, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="{x:Static r:Strings.Win_Language}" AutomationProperties.AutomationId="LanguageButton"
                        AutomationProperties.Name="{x:Static r:Strings.Win_Language}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,1,6,0"/>
                        <TextBlock Text="{Binding OtherLanguageName}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="{x:Static r:Strings.Win_Minimize}"
                            AutomationProperties.AutomationId="MinimizeButton" AutomationProperties.Name="{x:Static r:Strings.Win_Minimize}"/>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="{x:Static r:Strings.Win_Maximize}"
                            AutomationProperties.AutomationId="MaximizeButton" AutomationProperties.Name="{x:Static r:Strings.Win_Maximize}"/>
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="{x:Static r:Strings.Win_Close}"
                            AutomationProperties.AutomationId="CloseButton" AutomationProperties.Name="{x:Static r:Strings.Win_Close}"/>
                </StackPanel>
            </Grid>
        </Border>
        <ContentControl Content="{Binding Page}" Focusable="False"/>
    </DockPanel>
</Window>
