<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PcCheck</AssemblyName>
    <RootNamespace>PcCheck.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\pitstop.ico</ApplicationIcon>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF native DLLs (wpfgfx, PresentationNative...) land beside the exe without this -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>ko;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF drops System.IO from implicit usings to avoid a clash with System.Windows.Shapes.Path -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\pitstop.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\config\*.json" LinkBase="config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcCheck.Core\PcCheck.Core.csproj" />
    <ProjectReference Include="..\PcCheck.Collectors\PcCheck.Collectors.csproj" />
    <ProjectReference Include="..\PcCheck.Analysis\PcCheck.Analysis.csproj" />
    <ProjectReference Include="..\PcCheck.Remediation\PcCheck.Remediation.csproj" />
    <ProjectReference Include="..\PcCheck.Report\PcCheck.Report.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
